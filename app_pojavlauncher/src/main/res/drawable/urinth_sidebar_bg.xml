<?xml version="1.0" encoding="utf-8"?>
<!-- A subtle vertical gradient instead of a flat fill, plus a thin green-tinted edge on the
     right where the sidebar meets the main content, for a less flat, more "designed" panel. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#C2071320"
                android:centerColor="#C2050F18"
                android:endColor="#C2040C14" />
        </shape>
    </item>
    <item android:width="1dp" android:gravity="right">
        <shape android:shape="rectangle">
            <solid android:color="#2A1FC77A" />
        </shape>
    </item>
</layer-list>
