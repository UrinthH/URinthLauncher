<?xml version="1.0" encoding="utf-8"?>
<!-- Shared background for every card on the home screen (account, installations, activity,
     news). A soft diagonal gradient and a faint green-tinted border read as more "designed"
     than the old flat gray fill, without changing any layout. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#D40F2130"
        android:centerColor="#D40B1A24"
        android:endColor="#D409161F" />
    <stroke android:width="1dp" android:color="#3A1FC77A" />
    <corners android:radius="10dp" />
</shape>
