<?xml version="1.0" encoding="utf-8"?>
<!-- Simple front-facing grass block: bold flat shapes so it stays readable down to ~14dp,
     instead of a fine isometric cube that blurs into a blob at small sizes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Dirt body with rounded corners -->
    <path
        android:fillColor="#8B5A2B"
        android:pathData="M4,1 L20,1 A3,3 0 0 1 23,4 L23,20 A3,3 0 0 1 20,23 L4,23 A3,3 0 0 1 1,20 L1,4 A3,3 0 0 1 4,1 Z" />

    <!-- Grass top, following the same rounded corners -->
    <path
        android:fillColor="#6CC24A"
        android:pathData="M4,1 L20,1 A3,3 0 0 1 23,4 L23,9 L1,9 L1,4 A3,3 0 0 1 4,1 Z" />

    <!-- Darker grass rim where it meets the dirt -->
    <path
        android:fillColor="#4E9B35"
        android:pathData="M1,9 L23,9 L23,11.5 L1,11.5 Z" />

    <!-- A couple of lighter grass flecks for texture -->
    <path android:fillColor="#86D468" android:pathData="M5,3.5 h3 v2 h-3 Z" />
    <path android:fillColor="#86D468" android:pathData="M14,5 h4 v1.6 h-4 Z" />

    <!-- Dirt specks for texture -->
    <path android:fillColor="#73471F" android:pathData="M5,15 h3 v2.4 h-3 Z" />
    <path android:fillColor="#73471F" android:pathData="M14.5,18 h4 v2 h-4 Z" />
    <path android:fillColor="#A06C37" android:pathData="M10,13.5 h2.5 v2 h-2.5 Z" />

    <!-- Crisp outline so the block reads clearly against any background -->
    <path
        android:fillColor="#00000000"
        android:pathData="M4,1 L20,1 A3,3 0 0 1 23,4 L23,20 A3,3 0 0 1 20,23 L4,23 A3,3 0 0 1 1,20 L1,4 A3,3 0 0 1 4,1 Z"
        android:strokeColor="#3D2912"
        android:strokeWidth="1.1" />
</vector>
