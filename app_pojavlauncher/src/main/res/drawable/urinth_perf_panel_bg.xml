<?xml version="1.0" encoding="utf-8"?>
<!-- Performance Mode card: solid and quiet. A thin green edge shows when the mode is on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#0D1B21" />
            <stroke android:width="1dp" android:color="#2E8F68" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D1920" />
            <stroke android:width="1dp" android:color="#1E3640" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
