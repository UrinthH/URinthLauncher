<?xml version="1.0" encoding="utf-8"?>
<!-- Performance Mode card: a soft diagonal gradient with a thin edge; greener when the mode is on.
     The hex pattern, meter bars, corner marks and light sweep are drawn on top by PerformanceCardArt. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#0A1A1C"
                android:startColor="#123A33" />
            <stroke android:width="1dp" android:color="#3AA67F" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#09141A"
                android:startColor="#12232C" />
            <stroke android:width="1dp" android:color="#22404C" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
