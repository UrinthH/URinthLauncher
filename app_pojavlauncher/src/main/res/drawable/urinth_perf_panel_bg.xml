<?xml version="1.0" encoding="utf-8"?>
<!-- Performance Mode card: the normal home panel when off, a green-lit panel when on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#E6103B2C"
                android:centerColor="#E60B2A22"
                android:endColor="#E609161F" />
            <stroke android:width="1.5dp" android:color="#1FC77A" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/urinth_panel_bg" />
</selector>
