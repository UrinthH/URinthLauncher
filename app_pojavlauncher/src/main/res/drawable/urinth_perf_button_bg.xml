<?xml version="1.0" encoding="utf-8"?>
<!-- Boost button: quiet outline when off, solid green when Performance Mode is on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1FC77A" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#2A1FC77A" />
            <stroke android:width="1dp" android:color="#1FC77A" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#121FC77A" />
            <stroke android:width="1dp" android:color="#2E8F68" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
