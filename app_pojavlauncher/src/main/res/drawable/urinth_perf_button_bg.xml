<?xml version="1.0" encoding="utf-8"?>
<!-- Boost button: dark glass with a green outline when off, a bright green gradient when on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#17B26B"
                android:startColor="#3BE9A0" />
            <stroke android:width="1dp" android:color="#7FF2C4" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#2E1FC77A"
                android:startColor="#401FC77A" />
            <stroke android:width="1dp" android:color="#1FC77A" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#0C1FC77A"
                android:startColor="#241FC77A" />
            <stroke android:width="1dp" android:color="#2E8F68" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
