<?xml version="1.0" encoding="utf-8"?>
<!-- Boost button: solid green pill; a deeper green once the mode is on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle"><solid android:color="#FF14A765" /><corners android:radius="20dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#FF14A765" /><corners android:radius="20dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#FF1FC77A" /><corners android:radius="20dp" /></shape>
    </item>
</selector>
