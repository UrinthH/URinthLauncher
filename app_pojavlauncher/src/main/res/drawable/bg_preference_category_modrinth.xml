<?xml version="1.0" encoding="utf-8"?>
<!-- Category header pill, recolored from the original teal to the launcher's green brand so
     every screen (home, settings, create profile) reads as one design system. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="12dp" />
    <gradient
        android:angle="315"
        android:startColor="#301FC77A"
        android:centerColor="#1A1FC77A"
        android:endColor="#0F1A24" />
    <stroke android:width="1dp" android:color="#551FC77A" />
</shape>
