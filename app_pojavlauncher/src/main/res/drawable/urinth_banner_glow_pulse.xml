<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Same idea as urinth_hero_glow_pulse, kept as its own file so the banner photo's sun
         position can be tuned separately from the hero's without moving both at once. -->
    <gradient
        android:type="radial"
        android:gradientRadius="220dp"
        android:centerX="0.78"
        android:centerY="0.3"
        android:startColor="#F2FFE9A8"
        android:centerColor="#80FFB04D"
        android:endColor="#00FF8A3D" />
    <corners android:radius="12dp"/>
</shape>
