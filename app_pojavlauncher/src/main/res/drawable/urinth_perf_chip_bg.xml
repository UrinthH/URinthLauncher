<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded square behind the bolt icon, with a thin ring that turns green when the mode is on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#2214A862"
                android:startColor="#551FC77A" />
            <stroke android:width="1dp" android:color="#8F1FC77A" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="#0AFFFFFF"
                android:startColor="#22FFFFFF" />
            <stroke android:width="1dp" android:color="#24FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
