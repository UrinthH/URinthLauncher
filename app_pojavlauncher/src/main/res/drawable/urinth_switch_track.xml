<?xml version="1.0" encoding="utf-8"?>
<!-- Switch track: light grey pill when off, solid green pill when on. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="46dp" android:height="26dp" />
            <solid android:color="#FF1FC77A" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="46dp" android:height="26dp" />
            <solid android:color="#FFDCE3EA" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</selector>
