<?xml version="1.0" encoding="utf-8"?>
<!-- A soft red glow hugging every edge of the screen, faked with several nested stroked
     rectangles (outermost = thin and bright, each one further in = wider and dimmer) since
     a real blur isn't available down to minSdk 21. The whole thing's alpha is pulsed in code. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Widest, dimmest falloff -->
    <item android:left="0dp" android:top="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="26dp" android:color="#14FF1744" />
        </shape>
    </item>

    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="18dp" android:color="#24FF1744" />
        </shape>
    </item>

    <item android:left="8dp" android:top="8dp" android:right="8dp" android:bottom="8dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="10dp" android:color="#40FF2A3F" />
        </shape>
    </item>

    <!-- Thin bright core line right at the edge -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="2.5dp" android:color="#E6FF3B30" />
        </shape>
    </item>

</layer-list>
