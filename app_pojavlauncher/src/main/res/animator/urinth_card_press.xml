<?xml version="1.0" encoding="utf-8"?>
<!-- Cards sink slightly while pressed and spring back, so every tap has visible feedback. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.975" android:valueType="floatType" android:duration="110" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.975" android:valueType="floatType" android:duration="110" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1" android:valueType="floatType" android:duration="200" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1" android:valueType="floatType" android:duration="200" />
        </set>
    </item>
</selector>
