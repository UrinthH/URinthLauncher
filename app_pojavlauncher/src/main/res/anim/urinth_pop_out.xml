<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/urinth_ease_in"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="240" />
    <scale
        android:fromXScale="1" android:toXScale="0.95"
        android:fromYScale="1" android:toYScale="0.95"
        android:pivotX="50%" android:pivotY="40%"
        android:duration="260" />
</set>
