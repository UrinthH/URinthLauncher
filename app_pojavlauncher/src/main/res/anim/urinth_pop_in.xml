<?xml version="1.0" encoding="utf-8"?>
<!-- Soft pop-in for popups: fades in while growing from 92% with an ease-out curve. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:shareInterpolator="true">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="180" />
    <scale
        android:fromXScale="0.92" android:toXScale="1"
        android:fromYScale="0.92" android:toYScale="1"
        android:pivotX="50%" android:pivotY="0%"
        android:duration="240" />
</set>
