<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="urinth_splash_bg">#FFFFFF</color>

    <!-- Entry theme: white from the very first frame, the colour the intro starts on. -->
    <style name="MojoLauncher.Splash" parent="MojoLauncher.AppTheme">
        <item name="android:windowBackground">@color/urinth_splash_bg</item>
        <item name="android:statusBarColor">@color/urinth_splash_bg</item>
        <item name="android:navigationBarColor">@color/urinth_splash_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
