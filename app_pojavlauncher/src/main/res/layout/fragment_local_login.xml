<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#B8000D18"
    android:paddingHorizontal="24dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/login_menu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/background_card"
        android:padding="24dp"
        app:layout_constraintWidth_max="480dp"
        app:layout_constraintWidth_percent="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/local_login_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Add a local account"
            android:textColor="#F2F8FA"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/local_login_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Choose an offline Minecraft username"
            android:textColor="#A3B8C3"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/local_login_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/local_login_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/login_online_username_hint"
            android:textColor="#DCE9EE"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/local_login_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.kdt.mcgui.MineEditText
            android:id="@+id/login_edit_email"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:imeOptions="flagNoExtractUi"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="#F2F8FA"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/local_login_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <com.kdt.mcgui.MineButton
            android:id="@+id/login_button"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#00DDB5"
            android:onClick="loginMC"
            android:text="@string/login_online_login_label"
            android:textColor="#03201F"
            app:layout_constraintTop_toBottomOf="@id/login_edit_email"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>