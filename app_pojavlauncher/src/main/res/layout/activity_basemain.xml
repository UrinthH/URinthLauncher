<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_height="match_parent"
	android:layout_width="match_parent"
	android:layout_alignParentRight="true"
	android:id="@+id/main_drawer_options"
	android:background="@drawable/no_focus_shown"
	android:keepScreenOn="true">

	<FrameLayout
		android:id="@+id/content_frame"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<net.kdt.pojavlaunch.customcontrols.ControlLayout
			android:id="@+id/main_control_layout"
			android:layout_width="match_parent"
			android:layout_height="match_parent">

			<net.kdt.pojavlaunch.game.GameView
				android:id="@+id/main_game_render_view"
				android:layout_width="fill_parent"
				android:layout_height="fill_parent"
				android:defaultFocusHighlightEnabled="false"
                tools:ignore="UnusedAttribute">

				<net.kdt.pojavlaunch.game.GameCursorView
					android:layout_height="match_parent"
					android:layout_width="match_parent"
					android:orientation="vertical"
					android:id="@+id/main_cursorview"
					android:focusable="false"
					android:translationZ="1dp"
					android:visibility="gone"
					app:defaultCursorDrawable="@drawable/ic_mouse_pointer"/>

			</net.kdt.pojavlaunch.game.GameView>


			<net.kdt.pojavlaunch.customcontrols.keyboard.TouchCharInput
				android:id="@+id/mainTouchCharInput"
				android:layout_width="1dp"
				android:layout_height="1dp"
				android:background="@android:color/darker_gray"
				android:ems="10"
				android:imeOptions="flagNoFullscreen|flagNoExtractUi|flagNoPersonalizedLearning|actionDone"
				android:inputType="textFilter|textImeMultiLine|textAutoComplete|textAutoCorrect"
				tools:ignore="TouchTargetSizeCheck" />

			<net.kdt.pojavlaunch.customcontrols.handleview.DrawerPullButton
				android:id="@+id/drawer_button"
				android:layout_width="40dp"
				android:layout_height="20dp"
				android:padding="8dp"
				android:elevation="10dp"
				android:layout_gravity="center_horizontal"/>
			<net.kdt.pojavlaunch.customcontrols.mouse.HotbarView
				android:id="@+id/hotbar_view"
				android:layout_width="0px"
				android:layout_height="0px"/>

		</net.kdt.pojavlaunch.customcontrols.ControlLayout>

		<!-- The white page with the loading screen on it as a small, wide, rounded window. When the
		     game is up, the window zooms to full screen (see LaunchWindowLayout). The child that is
		     a LaunchLoadingView is the window; the other child is the text under it. -->
		<net.kdt.pojavlaunch.game.LaunchWindowLayout
			android:id="@+id/main_loading_screen"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:background="@color/urinth_loading_bg"
			android:visibility="visible"
			>

			<net.kdt.pojavlaunch.game.LaunchLoadingView
				android:id="@+id/main_loading_view"
				android:layout_width="match_parent"
				android:layout_height="match_parent" />

			<!-- Stage and elapsed time, drawn as text so they stay readable and translatable.
			     LaunchWindowLayout puts this block under the window. -->
			<LinearLayout
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:orientation="vertical">

				<TextView
					android:id="@+id/main_loading_screen_text"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/loading_screen_title"
					android:textAllCaps="true"
					android:letterSpacing="0.12"
					android:textColor="#FF0F8A52"
					android:textStyle="bold"
					android:textSize="13sp" />

				<TextView
					android:id="@+id/main_loading_screen_warning"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="4dp"
					android:text="@string/loading_screen_warning"
					android:textColor="#FF6B7A87"
					android:textSize="11sp" />
			</LinearLayout>
		</net.kdt.pojavlaunch.game.LaunchWindowLayout>

		<com.kdt.LoggerView
			android:id="@+id/mainLoggerView"
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:visibility="gone"
			/>

	</FrameLayout>

	<ListView
		android:layout_width="240dp"
		android:layout_height="match_parent"
		android:layout_gravity="right"
		android:background="@drawable/game_menu_bg"
		android:clipToPadding="false"
		android:divider="@null"
		android:dividerHeight="0dp"
		android:fitsSystemWindows="false"
		android:listSelector="@android:color/transparent"
		android:paddingTop="14dp"
		android:paddingBottom="14dp"
		android:scrollbars="none"
		android:id="@+id/main_navigation_view"/>

</androidx.drawerlayout.widget.DrawerLayout>

