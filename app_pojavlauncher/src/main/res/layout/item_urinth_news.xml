<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/urinth_panel_bg"
    android:orientation="vertical"
    android:padding="6dp">

    <ImageView
        android:id="@+id/urinth_news_image"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/urinth_news_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="#F2F8FA"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/urinth_news_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#ABC0CB"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/urinth_news_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#ABC0CB"
        android:textSize="9sp" />
</LinearLayout>
