<?xml version="1.0" encoding="utf-8"?>
<!-- Top of the settings list: the title and chips that show the current graphics, memory and mode.
     Filled in by SettingsHeaderPreference. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="20dp"
    android:paddingEnd="6dp"
    android:paddingBottom="2dp">

    <TextView
        android:id="@+id/settings_header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/urinth_set_title"
        android:textColor="#101828"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/settings_header_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/urinth_set_subtitle"
        android:textColor="#667085"
        android:textSize="14sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/settings_chip_graphics"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:textColor="#344054"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/settings_chip_memory"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:textColor="#344054"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/settings_chip_mode"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:textColor="#344054"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
