<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/urinth_screen_bg"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/urinth_topbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/urinth_topbar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/urinth_menu_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/urinth_menu_desc"
            android:padding="8dp"
            android:src="@drawable/ic_urinth_menu" />

        <ImageView
            android:id="@+id/urinth_logo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:src="@drawable/urinth_home_block" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/urinth_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/urinth_brand"
                android:textColor="#F2F8FA"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/urinth_subtitle"
                android:textColor="#1FC77A"
                android:textSize="9sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/urinth_btn_folder"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/urinth_btn_folder_desc"
            android:padding="9dp"
            android:src="@drawable/ic_px_folder"
            android:tint="#F2F8FA" />

        <ImageView
            android:id="@+id/urinth_btn_people"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/urinth_btn_people_desc"
            android:padding="9dp"
            android:src="@drawable/ic_urinth_person" />

        <ImageView
            android:id="@+id/urinth_btn_download"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/urinth_btn_download_desc"
            android:padding="9dp"
            android:src="@drawable/ic_px_file_dl"
            android:tint="#F2F8FA" />

        <ImageView
            android:id="@+id/urinth_btn_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/urinth_btn_settings_desc"
            android:padding="9dp"
            android:src="@drawable/ic_sharp_settings_24"
            android:tint="#F2F8FA" />

        <ImageView
            android:id="@+id/urinth_btn_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/urinth_btn_more_desc"
            android:padding="8dp"
            android:src="@drawable/ic_urinth_more" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Sidebar -->
        <LinearLayout
            android:id="@+id/urinth_sidebar"
            android:layout_width="118dp"
            android:layout_height="match_parent"
            android:background="#B0061019"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/urinth_nav_home"
                style="@style/UrinthNavItem"
                android:background="@drawable/urinth_nav_active">
                <ImageView style="@style/UrinthNavIcon" android:src="@drawable/ic_px_home" />
                <TextView style="@style/UrinthNavText" android:text="@string/urinth_nav_home" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/urinth_nav_news"
                style="@style/UrinthNavItem">
                <ImageView style="@style/UrinthNavIcon" android:src="@drawable/ic_px_book" />
                <TextView style="@style/UrinthNavText" android:text="@string/urinth_nav_news" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/urinth_nav_installations"
                style="@style/UrinthNavItem">
                <ImageView style="@style/UrinthNavIcon" android:src="@drawable/ic_urinth_cube" />
                <TextView style="@style/UrinthNavText" android:text="@string/urinth_nav_installations" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/urinth_nav_skins"
                style="@style/UrinthNavItem">
                <ImageView style="@style/UrinthNavIcon" android:src="@drawable/ic_urinth_person" />
                <TextView style="@style/UrinthNavText" android:text="@string/urinth_nav_skins" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/urinth_nav_settings"
                style="@style/UrinthNavItem">
                <ImageView style="@style/UrinthNavIcon" android:src="@drawable/ic_sharp_settings_24" />
                <TextView style="@style/UrinthNavText" android:text="@string/urinth_nav_settings" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/urinth_dot" />

                <TextView
                    android:id="@+id/urinth_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/urinth_status_ready"
                    android:textColor="#F2F8FA"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:text="@string/urinth_tagline"
                android:textColor="#ABC0CB"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Centre: hero, news, installations. The center fragment host sits on top when a screen opens. -->
        <FrameLayout
            android:id="@+id/urinth_center_host"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ScrollView
                android:id="@+id/urinth_home_scroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="150dp"
                        android:background="@drawable/urinth_panel_bg">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop"
                            android:src="@drawable/urinth_hero" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/urinth_hero_fade" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="bottom"
                            android:orientation="vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/urinth_pill_bg"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:text="@string/urinth_brand"
                                android:textColor="#1FC77A"
                                android:textSize="9sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/urinth_hero_title"
                                android:textColor="#F2F8FA"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/urinth_hero_sub"
                                android:textColor="#ABC0CB"
                                android:textSize="11sp" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/urinth_play"
                                    android:layout_width="124dp"
                                    android:layout_height="40dp"
                                    android:background="@drawable/urinth_play_bg"
                                    android:drawablePadding="6dp"
                                    android:drawableStart="@drawable/ic_urinth_play"
                                    android:gravity="center"
                                    android:text="@string/urinth_play"
                                    android:textColor="#FFFFFF"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:id="@+id/urinth_last_played_btn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="40dp"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/urinth_pill_bg"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="8dp">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_urinth_clock" />

                                    <TextView
                                        android:id="@+id/urinth_last_played_name"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:maxWidth="110dp"
                                        android:singleLine="true"
                                        android:ellipsize="end"
                                        android:text="@string/urinth_last_played"
                                        android:textColor="#F2F8FA"
                                        android:textSize="11sp" />

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_marginStart="4dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_urinth_chevron" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/urinth_explore_worlds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|top"
                            android:layout_margin="10dp"
                            android:background="@drawable/urinth_pill_bg"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            android:text="@string/urinth_explore_worlds"
                            android:textColor="#F2F8FA"
                            android:textSize="10sp" />
                    </FrameLayout>

                    <!-- Latest news -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_px_book"
                            android:tint="#1FC77A" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:text="@string/urinth_news_title"
                            android:textColor="#F2F8FA"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/urinth_news_all"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="@string/urinth_news_all"
                            android:textColor="#1FC77A"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/urinth_news_1"
                            layout="@layout/item_urinth_news"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/urinth_news_2"
                            layout="@layout/item_urinth_news"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1" />

                        <include
                            android:id="@+id/urinth_news_3"
                            layout="@layout/item_urinth_news"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <!-- Add-ons banner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/urinth_panel_bg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="10dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:contentDescription="@null"
                            android:src="@drawable/urinth_home_block" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/urinth_addons_title"
                                android:textColor="#F2F8FA"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/urinth_addons_sub"
                                android:textColor="#ABC0CB"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/urinth_addons_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/urinth_pill_bg"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"
                            android:text="@string/urinth_addons_btn"
                            android:textColor="#1FC77A"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Your installations -->
                    <LinearLayout
                        android:id="@+id/urinth_installations_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/urinth_panel_bg"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:contentDescription="@null"
                                android:src="@drawable/urinth_home_block" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/urinth_installations_title"
                                android:textColor="#F2F8FA"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/urinth_installations_list"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/urinth_installations_empty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/urinth_installations_empty"
                            android:textColor="#ABC0CB"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>

            <!-- Screens opened from the sidebar, the top bar or the hero (settings, editor, browsers). -->
            <FrameLayout
                android:id="@+id/urinth_center_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF0B1A24"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Right column -->
        <ScrollView
            android:id="@+id/urinth_right_scroll"
            android:layout_width="196dp"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="6dp"
                android:paddingEnd="10dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <!-- Account -->
                <LinearLayout
                    android:id="@+id/urinth_account_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/urinth_panel_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="10dp">

                    <ImageView
                        android:id="@+id/urinth_account_avatar"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:scaleType="centerInside"
                        android:src="@drawable/urinth_home_block" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/urinth_account_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="#F2F8FA"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/urinth_account_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="#ABC0CB"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_urinth_chevron" />
                </LinearLayout>

                <!-- Installed versions -->
                <LinearLayout
                    android:id="@+id/urinth_versions_row"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/urinth_panel_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/urinth_home_block" />

                    <TextView
                        android:id="@+id/urinth_versions_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:textColor="#F2F8FA"
                        android:textSize="11sp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_urinth_chevron" />
                </LinearLayout>

                <!-- Quick links -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/urinth_panel_bg"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:id="@+id/urinth_link_quick"
                        style="@style/UrinthLinkRow">
                        <ImageView style="@style/UrinthLinkIcon" android:src="@drawable/ic_px_zap" android:tint="#F2F8FA" />
                        <TextView style="@style/UrinthLinkText" android:text="@string/urinth_link_quick" />
                        <ImageView style="@style/UrinthLinkChevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/urinth_link_website"
                        style="@style/UrinthLinkRow">
                        <ImageView style="@style/UrinthLinkIcon" android:src="@drawable/ic_urinth_globe" android:tint="#F2F8FA" />
                        <TextView style="@style/UrinthLinkText" android:text="@string/urinth_link_website" />
                        <ImageView style="@style/UrinthLinkChevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/urinth_link_discord"
                        style="@style/UrinthLinkRow">
                        <ImageView style="@style/UrinthLinkIcon" android:src="@drawable/ic_discord" />
                        <TextView style="@style/UrinthLinkText" android:text="@string/urinth_link_discord" />
                        <ImageView style="@style/UrinthLinkChevron" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/urinth_link_docs"
                        style="@style/UrinthLinkRow">
                        <ImageView style="@style/UrinthLinkIcon" android:src="@drawable/ic_px_book" android:tint="#F2F8FA" />
                        <TextView style="@style/UrinthLinkText" android:text="@string/urinth_link_docs" />
                        <ImageView style="@style/UrinthLinkChevron" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Recent activity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/urinth_panel_bg"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_urinth_clock" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/urinth_activity_title"
                            android:textColor="#F2F8FA"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/urinth_activity_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/urinth_activity_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/urinth_activity_empty"
                        android:textColor="#ABC0CB"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
