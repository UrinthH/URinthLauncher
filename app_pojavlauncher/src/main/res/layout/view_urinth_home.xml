<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed-size home page, built for a landscape screen about 360dp tall. Nothing scrolls: every
     block has a fixed height or a weight, and every list is capped in UrinthHomeController.
     Wrapped in an outer FrameLayout so the red edge-glow overlay can sit on top of everything
     else without affecting the vertical layout underneath. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/urinth_screen_bg"
    android:orientation="vertical">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/urinth_topbar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/urinth_topbar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/urinth_menu_btn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/urinth_menu_desc"
            android:padding="8dp"
            android:src="@drawable/ic_urinth_menu" />

        <ImageView
            android:id="@+id/urinth_logo"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_minecraft_grass_block" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/urinth_brand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/urinth_brand"
                android:textColor="#F2F8FA"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/urinth_subtitle"
                android:textColor="#1FC77A"
                android:textSize="8.5sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Credit line, replacing the old folder/accounts/download/settings/more icon row.
             Those actions all live in the sidebar now (Installations, Servers, Settings) or on
             the account card, so nothing is lost by dropping the icons. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/urinth_made_by_label"
                android:textColor="#1FC77A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <net.kdt.pojavlaunch.fragments.ShimmerTextView
                android:id="@+id/urinth_credit_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/urinth_made_by_name"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Sidebar -->
        <LinearLayout
            android:id="@+id/urinth_sidebar"
            android:layout_width="110dp"
            android:layout_height="match_parent"
            android:background="@drawable/urinth_sidebar_bg"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/urinth_nav_home"
                style="@style/UrinthNavItem"
                android:background="@drawable/urinth_nav_active">
                <ImageView style="@style/UrinthNavIcon" android:src="@drawable/ic_px_home" />
                <TextView style="@style/UrinthNavText" android:text="@string/urinth_nav_home" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/urinth_nav_news"
                style="@style/UrinthNavItem"
                android:background="@drawable/urinth_nav_idle">
                <ImageView style="@style/UrinthNavIcon" android:src="@drawable/ic_px_file_dl" />
                <TextView style="@style/UrinthNavText" android:text="@string/urinth_nav_news" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/urinth_nav_installations"
                style="@style/UrinthNavItem"
                android:background="@drawable/urinth_nav_idle">
                <ImageView style="@style/UrinthNavIcon" android:src="@drawable/ic_urinth_cube" />
                <TextView style="@style/UrinthNavText" android:text="@string/urinth_nav_installations" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/urinth_nav_skins"
                style="@style/UrinthNavItem"
                android:background="@drawable/urinth_nav_idle">
                <ImageView style="@style/UrinthNavIcon" android:src="@drawable/ic_urinth_globe" />
                <TextView style="@style/UrinthNavText" android:text="@string/urinth_nav_skins" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/urinth_nav_settings"
                style="@style/UrinthNavItem"
                android:background="@drawable/urinth_nav_idle">
                <ImageView style="@style/UrinthNavIcon" android:src="@drawable/ic_sharp_settings_24" />
                <TextView style="@style/UrinthNavText" android:text="@string/urinth_nav_settings" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/urinth_dot" />

                <TextView
                    android:id="@+id/urinth_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/urinth_status_ready"
                    android:textColor="#F2F8FA"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/urinth_tagline"
                android:textColor="#ABC0CB"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Main area. The home page and the centre container share this host; a settings or editor
             screen opens over the whole page. -->
        <FrameLayout
            android:id="@+id/urinth_center_host"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp">

                <!-- Row 1: hero, with account, installed versions and quick links beside it -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="146dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/urinth_panel_bg"
                        android:clipToOutline="true">

                        <!-- Real photo: a file named urinth_photo_hero in res/drawable. Until then this is a plain dark panel. -->
                        <ImageView
                            android:id="@+id/urinth_hero_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="#FF0E1E28"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/urinth_hero_fade_light" />

                        <!-- Alpha is pulsed in code (UrinthHomeController) for a slow glowing effect. -->
                        <View
                            android:id="@+id/urinth_hero_glow"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/urinth_hero_glow_pulse" />

                        <!-- Branding and tagline are baked into the hero photo. Keep only launcher controls. -->

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="30dp"
                                android:layout_gravity="start|bottom"
                                android:layout_margin="12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/urinth_play"
                                    android:layout_width="112dp"
                                    android:layout_height="30dp"
                                    android:background="@drawable/urinth_play_bg"
                                    android:drawablePadding="6dp"
                                    android:drawableStart="@drawable/ic_urinth_play"
                                    android:gravity="center"
                                    android:text="@string/urinth_play"
                                    android:textColor="#FFFFFF"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:id="@+id/urinth_last_played_btn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="30dp"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/urinth_pill_bg"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal"
                                    android:paddingStart="10dp"
                                    android:paddingEnd="8dp">

                                    <ImageView
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_urinth_clock" />

                                    <TextView
                                        android:id="@+id/urinth_last_played_name"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="6dp"
                                        android:ellipsize="end"
                                        android:maxWidth="170dp"
                                        android:singleLine="true"
                                        android:text="@string/urinth_last_played"
                                        android:textColor="#F2F8FA"
                                        android:textSize="10sp" />

                                    <ImageView
                                        android:layout_width="10dp"
                                        android:layout_height="10dp"
                                        android:layout_marginStart="4dp"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_urinth_chevron" />
                                </LinearLayout>
                            </LinearLayout>

                        <TextView
                            android:id="@+id/urinth_explore_worlds"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end|top"
                            android:layout_margin="8dp"
                            android:background="@drawable/urinth_pill_bg"
                            android:paddingStart="8dp"
                            android:paddingTop="4dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="4dp"
                            android:singleLine="true"
                            android:text="@string/urinth_explore_worlds"
                            android:textColor="#F2F8FA"
                            android:textSize="9sp" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_urinth_arrow"
                            android:tint="#1FC77A" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="6dp"
                            android:orientation="horizontal">

                            <View
                                android:layout_width="5dp"
                                android:layout_height="5dp"
                                android:background="@drawable/urinth_dot" />

                            <View
                                android:layout_width="5dp"
                                android:layout_height="5dp"
                                android:layout_marginStart="4dp"
                                android:alpha="0.35"
                                android:background="@drawable/urinth_dot" />

                            <View
                                android:layout_width="5dp"
                                android:layout_height="5dp"
                                android:layout_marginStart="4dp"
                                android:alpha="0.35"
                                android:background="@drawable/urinth_dot" />

                            <View
                                android:layout_width="5dp"
                                android:layout_height="5dp"
                                android:layout_marginStart="4dp"
                                android:alpha="0.35"
                                android:background="@drawable/urinth_dot" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Account, installed versions and quick links -->
                    <LinearLayout
                        android:layout_width="160dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/urinth_account_card"
                            android:layout_width="match_parent"
                            android:layout_height="66dp"
                            android:background="@drawable/urinth_panel_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <ImageView
                                android:id="@+id/urinth_account_avatar"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:contentDescription="@null"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_minecraft_grass_block" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/urinth_account_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:singleLine="true"
                                    android:textColor="#F2F8FA"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/urinth_account_status"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:ellipsize="end"
                                    android:singleLine="true"
                                    android:textColor="#ABC0CB"
                                    android:textSize="9.5sp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_urinth_chevron" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="76dp"
                            android:layout_marginTop="4dp"
                            android:background="@drawable/urinth_panel_bg"
                            android:orientation="vertical"
                            android:paddingTop="2dp"
                            android:paddingBottom="2dp">

                            <LinearLayout
                                android:id="@+id/urinth_link_quick"
                                android:layout_width="match_parent"
                                android:layout_height="18dp"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="8dp"
                                android:paddingEnd="6dp">

                                <ImageView
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_urinth_link"
                                    android:tint="#F2F8FA" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:singleLine="true"
                                    android:text="@string/urinth_link_quick"
                                    android:textColor="#F2F8FA"
                                    android:textSize="9sp" />

                                <ImageView
                                    android:layout_width="9dp"
                                    android:layout_height="9dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_urinth_external"
                                    android:tint="#ABC0CB" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/urinth_link_website"
                                android:layout_width="match_parent"
                                android:layout_height="18dp"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="8dp"
                                android:paddingEnd="6dp">

                                <ImageView
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_urinth_globe"
                                    android:tint="#F2F8FA" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:singleLine="true"
                                    android:text="@string/urinth_link_website"
                                    android:textColor="#F2F8FA"
                                    android:textSize="9sp" />

                                <ImageView
                                    android:layout_width="9dp"
                                    android:layout_height="9dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_urinth_external"
                                    android:tint="#ABC0CB" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/urinth_link_discord"
                                android:layout_width="match_parent"
                                android:layout_height="18dp"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="8dp"
                                android:paddingEnd="6dp">

                                <ImageView
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_discord" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:singleLine="true"
                                    android:text="@string/urinth_link_discord"
                                    android:textColor="#F2F8FA"
                                    android:textSize="9sp" />

                                <ImageView
                                    android:layout_width="9dp"
                                    android:layout_height="9dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_urinth_external"
                                    android:tint="#ABC0CB" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/urinth_link_docs"
                                android:layout_width="match_parent"
                                android:layout_height="18dp"
                                android:background="?attr/selectableItemBackground"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="8dp"
                                android:paddingEnd="6dp">

                                <ImageView
                                    android:layout_width="11dp"
                                    android:layout_height="11dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_px_book"
                                    android:tint="#F2F8FA" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:singleLine="true"
                                    android:text="@string/urinth_link_docs"
                                    android:textColor="#F2F8FA"
                                    android:textSize="9sp" />

                                <ImageView
                                    android:layout_width="9dp"
                                    android:layout_height="9dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_urinth_external"
                                    android:tint="#ABC0CB" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2: latest news and add-ons on the left, installations and activity on the right -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1.3"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="18dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_px_book"
                                android:tint="#1FC77A" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="5dp"
                                android:layout_weight="1"
                                android:singleLine="true"
                                android:text="@string/urinth_news_title"
                                android:textColor="#F2F8FA"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/urinth_news_all"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="2dp"
                                android:text="@string/urinth_news_all"
                                android:textColor="#1FC77A"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="6dp"
                            android:layout_weight="1"
                            android:orientation="horizontal">

                            <include
                                android:id="@+id/urinth_news_1"
                                layout="@layout/item_urinth_news"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1" />

                            <include
                                android:id="@+id/urinth_news_2"
                                layout="@layout/item_urinth_news"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1" />

                            <include
                                android:id="@+id/urinth_news_3"
                                layout="@layout/item_urinth_news"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1" />
                        </LinearLayout>

                        <!-- Add-ons banner. Real photo: a file named urinth_photo_banner in res/drawable. -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/urinth_panel_bg"
                            android:clipToOutline="true">

                            <ImageView
                                android:id="@+id/urinth_banner_image"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="#FF0E1E28"
                                android:contentDescription="@null"
                                android:scaleType="centerCrop" />

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/urinth_hero_fade" />

                            <!-- Alpha is pulsed in code (UrinthHomeController) for a slow glowing effect. -->
                            <View
                                android:id="@+id/urinth_banner_glow"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/urinth_banner_glow_pulse" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_urinth_crown"
                                    android:tint="#1FC77A" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:singleLine="true"
                                        android:text="@string/urinth_addons_title"
                                        android:textColor="#F2F8FA"
                                        android:textSize="9sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:singleLine="true"
                                        android:text="@string/urinth_addons_sub"
                                        android:textColor="#ABC0CB"
                                        android:textSize="7.5sp" />
                                </LinearLayout>

                                <TextView
                                    android:id="@+id/urinth_addons_btn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/urinth_pill_bg"
                                    android:paddingStart="8dp"
                                    android:paddingTop="4dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="4dp"
                                    android:singleLine="true"
                                    android:text="@string/urinth_addons_btn"
                                    android:textColor="#1FC77A"
                                    android:textSize="8.5sp" />
                            </LinearLayout>
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <!-- Your installations: shows the first installation; the rest are under Installations -->
                        <LinearLayout
                            android:id="@+id/urinth_installations_card"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/urinth_panel_bg"
                            android:orientation="vertical"
                            android:padding="6dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="16dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_minecraft_grass_block" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:singleLine="true"
                                    android:text="@string/urinth_installations_title"
                                    android:textColor="#F2F8FA"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- Every installation, newest at the bottom; scrolls when there are more than fit. -->
                            <ScrollView
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:fadeScrollbars="false"
                                android:overScrollMode="ifContentScrolls"
                                android:scrollbars="vertical">

                                <LinearLayout
                                    android:id="@+id/urinth_installations_list"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical" />
                            </ScrollView>

                            <TextView
                                android:id="@+id/urinth_installations_empty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:singleLine="true"
                                android:text="@string/urinth_installations_empty"
                                android:textColor="#ABC0CB"
                                android:textSize="9sp" />
                        </LinearLayout>

                        <!-- Performance Mode: one tap boost. Replaces the old Recent Activity card. -->
                        <LinearLayout
                            android:id="@+id/urinth_perf_panel"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="6dp"
                            android:layout_weight="1.3"
                            android:background="@drawable/urinth_perf_panel_bg"
                            android:orientation="vertical"
                            android:padding="8dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <FrameLayout
                                    android:id="@+id/urinth_perf_chip"
                                    android:layout_width="26dp"
                                    android:layout_height="26dp"
                                    android:background="@drawable/urinth_perf_chip_bg">

                                    <ImageView
                                        android:id="@+id/urinth_perf_icon"
                                        android:layout_width="14dp"
                                        android:layout_height="14dp"
                                        android:layout_gravity="center"
                                        android:contentDescription="@null"
                                        android:src="@drawable/ic_urinth_bolt" />
                                </FrameLayout>

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:singleLine="true"
                                    android:text="@string/urinth_perf_title"
                                    android:textColor="#F2F8FA"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/urinth_perf_state"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/urinth_perf_pill_bg"
                                    android:paddingStart="8dp"
                                    android:paddingTop="2dp"
                                    android:paddingEnd="8dp"
                                    android:paddingBottom="2dp"
                                    android:singleLine="true"
                                    android:text="@string/urinth_perf_state_off"
                                    android:textColor="#ABC0CB"
                                    android:textSize="8sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/urinth_perf_button"
                                android:layout_width="match_parent"
                                android:layout_height="28dp"
                                android:background="@drawable/urinth_perf_button_bg"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:singleLine="true"
                                android:text="@string/urinth_perf_button_off"
                                android:textColor="@color/urinth_perf_button_text"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Screens opened from the sidebar, the top bar or the hero (settings, editor, browsers). -->
            <FrameLayout
                android:id="@+id/urinth_center_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FF0B1A24"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

    <!-- A faint drift of white ash/snow specks over the whole screen, driven by its own frame
         loop in ParticleOverlayView. Kept deliberately subtle (few, small, slow, low opacity). -->
    <net.kdt.pojavlaunch.fragments.ParticleOverlayView
        android:id="@+id/urinth_particles"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:duplicateParentState="false"
        android:focusable="false" />

    <!-- Pulsing red glow hugging every edge of the screen: four separate strips, each a clean
         edge-to-transparent fade, so every strip lines up exactly with the real screen edge
         instead of a stroke centered on its own bounds. The whole group's alpha is animated in
         code (UrinthHomeController) and nothing here intercepts touches. -->
    <FrameLayout
        android:id="@+id/urinth_red_edge_glow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:duplicateParentState="false"
        android:focusable="false">

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_gravity="top"
            android:background="@drawable/urinth_edge_glow_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_gravity="bottom"
            android:background="@drawable/urinth_edge_glow_bottom" />

        <View
            android:layout_width="14dp"
            android:layout_height="match_parent"
            android:layout_gravity="left"
            android:background="@drawable/urinth_edge_glow_left" />

        <View
            android:layout_width="14dp"
            android:layout_height="match_parent"
            android:layout_gravity="right"
            android:background="@drawable/urinth_edge_glow_right" />

    </FrameLayout>

</FrameLayout>
