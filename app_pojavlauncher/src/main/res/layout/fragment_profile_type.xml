<?xml version="1.0" encoding="utf-8"?>
<!-- Create Profile screen, rebuilt as real Modrinth-style list cards: a dark rounded card per
     loader (urinth_profile_card_bg: white, rounded, hairline edge) with an icon tile, a title,
     a one-line description and a trailing chevron, on the light launcher page.
     Every id is unchanged, so ProfileTypeSelectFragment's click bindings still work untouched. -->
<com.kdt.DefocusableScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3F6FB"
    android:clipToPadding="false"
    android:overScrollMode="ifContentScrolls"
    android:scrollbarThumbVertical="@drawable/urinth_scroll_thumb"
    android:scrollbarSize="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/fragment_padding_medium"
        android:paddingBottom="@dimen/padding_large">

        <TextView
            android:id="@+id/title_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_large"
            android:background="@drawable/urinth_section_header_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:minHeight="42dp"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="@string/create_profile_vanilla_like_versions"
            android:textColor="#0F8A52"
            android:textSize="13sp"
            android:letterSpacing="0.04" />

        <!-- Vanilla -->
        <LinearLayout
            android:id="@+id/vanilla_profile"
            style="@style/UrinthProfileCard">
            <ImageView
                style="@style/UrinthProfileIcon"
                android:src="@drawable/ic_minecraft_grass_block" />
            <LinearLayout style="@style/UrinthProfileCardText">
                <TextView style="@style/UrinthProfileCardTitle" android:text="@string/urinth_loader_vanilla" />
                <TextView style="@style/UrinthProfileCardDesc" android:text="@string/urinth_loader_vanilla_desc" />
            </LinearLayout>
            <ImageView style="@style/UrinthProfileChevron" />
        </LinearLayout>

        <!-- OptiFine -->
        <LinearLayout
            android:id="@+id/optifine_profile"
            style="@style/UrinthProfileCard">
            <ImageView
                style="@style/UrinthProfileIcon"
                android:src="@drawable/ic_optifine" />
            <LinearLayout style="@style/UrinthProfileCardText">
                <TextView style="@style/UrinthProfileCardTitle" android:text="@string/urinth_loader_optifine" />
                <TextView style="@style/UrinthProfileCardDesc" android:text="@string/urinth_loader_optifine_desc" />
            </LinearLayout>
            <ImageView style="@style/UrinthProfileChevron" />
        </LinearLayout>

        <TextView
            android:id="@+id/title_modded_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/padding_extra_extra_large"
            android:background="@drawable/urinth_section_header_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:minHeight="42dp"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp"
            android:text="@string/create_profile_modded_versions"
            android:textColor="#0F8A52"
            android:textSize="13sp"
            android:letterSpacing="0.04" />

        <!-- Fabric -->
        <LinearLayout
            android:id="@+id/modded_profile_fabric"
            style="@style/UrinthProfileCard">
            <ImageView
                style="@style/UrinthProfileIcon"
                android:src="@drawable/ic_fabric" />
            <LinearLayout style="@style/UrinthProfileCardText">
                <TextView style="@style/UrinthProfileCardTitle" android:text="@string/urinth_loader_fabric" />
                <TextView style="@style/UrinthProfileCardDesc" android:text="@string/urinth_loader_fabric_desc" />
            </LinearLayout>
            <ImageView style="@style/UrinthProfileChevron" />
        </LinearLayout>

        <!-- Quilt -->
        <LinearLayout
            android:id="@+id/modded_profile_quilt"
            style="@style/UrinthProfileCard">
            <ImageView
                style="@style/UrinthProfileIcon"
                android:src="@drawable/ic_quilt" />
            <LinearLayout style="@style/UrinthProfileCardText">
                <TextView style="@style/UrinthProfileCardTitle" android:text="@string/urinth_loader_quilt" />
                <TextView style="@style/UrinthProfileCardDesc" android:text="@string/urinth_loader_quilt_desc" />
            </LinearLayout>
            <ImageView style="@style/UrinthProfileChevron" />
        </LinearLayout>

        <!-- Legacy Fabric -->
        <LinearLayout
            android:id="@+id/modded_profile_legacy_fabric"
            style="@style/UrinthProfileCard">
            <ImageView
                style="@style/UrinthProfileIcon"
                android:src="@drawable/ic_fabric" />
            <LinearLayout style="@style/UrinthProfileCardText">
                <TextView style="@style/UrinthProfileCardTitle" android:text="@string/urinth_loader_legacy_fabric" />
                <TextView style="@style/UrinthProfileCardDesc" android:text="@string/urinth_loader_legacy_fabric_desc" />
            </LinearLayout>
            <ImageView style="@style/UrinthProfileChevron" />
        </LinearLayout>

        <!-- Forge -->
        <LinearLayout
            android:id="@+id/modded_profile_forge"
            style="@style/UrinthProfileCard">
            <ImageView
                style="@style/UrinthProfileIcon"
                android:src="@drawable/ic_forge" />
            <LinearLayout style="@style/UrinthProfileCardText">
                <TextView style="@style/UrinthProfileCardTitle" android:text="@string/urinth_loader_forge" />
                <TextView style="@style/UrinthProfileCardDesc" android:text="@string/urinth_loader_forge_desc" />
            </LinearLayout>
            <ImageView style="@style/UrinthProfileChevron" />
        </LinearLayout>

        <!-- NeoForge -->
        <LinearLayout
            android:id="@+id/modded_profile_neoforge"
            style="@style/UrinthProfileCard">
            <ImageView
                style="@style/UrinthProfileIcon"
                android:src="@drawable/ic_neoforge" />
            <LinearLayout style="@style/UrinthProfileCardText">
                <TextView style="@style/UrinthProfileCardTitle" android:text="@string/urinth_loader_neoforge" />
                <TextView style="@style/UrinthProfileCardDesc" android:text="@string/urinth_loader_neoforge_desc" />
            </LinearLayout>
            <ImageView style="@style/UrinthProfileChevron" />
        </LinearLayout>

        <!-- Modpack search -->
        <LinearLayout
            android:id="@+id/modded_profile_modpack"
            style="@style/UrinthProfileCard">
            <ImageView
                style="@style/UrinthProfileIcon"
                android:src="@drawable/ic_curseforge" />
            <LinearLayout style="@style/UrinthProfileCardText">
                <TextView style="@style/UrinthProfileCardTitle" android:text="@string/urinth_loader_modpack" />
                <TextView style="@style/UrinthProfileCardDesc" android:text="@string/urinth_loader_modpack_desc" />
            </LinearLayout>
            <ImageView style="@style/UrinthProfileChevron" />
        </LinearLayout>

        <!-- Beta/Alpha -->
        <LinearLayout
            android:id="@+id/modded_profile_bta"
            style="@style/UrinthProfileCard">
            <ImageView
                style="@style/UrinthProfileIcon"
                android:src="@drawable/ic_minecraft_grass_block" />
            <LinearLayout style="@style/UrinthProfileCardText">
                <TextView style="@style/UrinthProfileCardTitle" android:text="@string/urinth_loader_bta" />
                <TextView style="@style/UrinthProfileCardDesc" android:text="@string/urinth_loader_bta_desc" />
            </LinearLayout>
            <ImageView style="@style/UrinthProfileChevron" />
        </LinearLayout>

    </LinearLayout>
</com.kdt.DefocusableScrollView>
