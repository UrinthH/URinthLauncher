<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="@null"
        android:src="@drawable/urinth_home_block" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/urinth_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#F2F8FA"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/urinth_row_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#ABC0CB"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/urinth_row_play"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/urinth_pill_bg"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:text="@string/urinth_play"
        android:textColor="#1FC77A"
        android:textSize="10sp" />

    <ImageView
        android:id="@+id/urinth_row_more"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/urinth_btn_more_desc"
        android:padding="7dp"
        android:src="@drawable/ic_urinth_more" />
</LinearLayout>
