<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_minecraft_grass_block" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/urinth_row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#F2F8FA"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/urinth_row_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#ABC0CB"
            android:textSize="8sp" />
    </LinearLayout>

    <!-- The hero Play button already starts this installation; the row only needs Edit (the
         3-dot menu below), so the row's own Play button was removed. -->
    <ImageView
        android:id="@+id/urinth_row_more"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="2dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/urinth_btn_more_desc"
        android:padding="5dp"
        android:src="@drawable/ic_urinth_more"
        android:tint="#F2F8FA" />
</LinearLayout>
